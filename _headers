# ═══════════════════════════════════════════════════════════
# NEXUS ART — Netlify Security Headers
# V1.6.1.1 — adapté Web3 (MetaMask/Base) + Netlify Forms
# ═══════════════════════════════════════════════════════════

/*
  # Force HTTPS + HSTS (2 ans, includeSubDomains, preload)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Block framing (clickjacking protection)
  X-Frame-Options: DENY
  # Block MIME sniffing
  X-Content-Type-Options: nosniff
  # (X-XSS-Protection retiré le 05/09/2026 : en-tête déprécié, le filtre qu'il pilotait n'existe plus ; la CSP fait ce travail)
  # Referrer Policy
  Referrer-Policy: strict-origin-when-cross-origin
  # Permissions Policy — minimal attack surface
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), display-capture=(), document-domain=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), fullscreen=(self), interest-cohort=()
  # Cross-Origin policies (COEP retiré pour compatibilité Web3 RPC)
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  # Content Security Policy, resserrée le 05/09/2026 sur ce que la page FAIT (mesuré) :
  #   - la page n'émet AUCUN appel réseau (0 fetch/XHR/WebSocket) : le RPC wallet passe par l'extension, pas par la page
  #     => connect-src ne porte que 'self' (+ l'hôte du widget Turnstile) ; les jokers *.base.org / *.basescan.org / *.coinbase.com étaient sans usage
  #   - toutes les images, polices et feuilles sont locales ou Google Fonts => img-src sans `https:` ; gstatic ne sert que des polices (font-src), googleapis que du CSS (style-src)
  #   - Turnstile exige script-src + frame-src https://challenges.cloudflare.com (doc Cloudflare)
  #   - block-all-mixed-content retiré : déprécié, upgrade-insecure-requests suffit
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; form-action 'self' https://*.netlify.com https://*.netlify.app; base-uri 'self'; upgrade-insecure-requests;
  # Cache Control pour HTML
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8
